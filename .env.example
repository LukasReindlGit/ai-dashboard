# Copy to .env and fill in. docker compose reads it for both variable
# substitution and the container environment.

# Login. Leave both empty: the first visit shows a setup screen that sets the password
# and the authenticator (TOTP) app; whoever opens it first can, so do it right after
# deploying. They are saved in data/auth.json.
# Set here, they take precedence (TOTP_SECRET is base32).
DASHBOARD_PASSWORD=
TOTP_SECRET=

# Served at https://$DOMAIN$BASE_PATH/ through nginx-proxy on $PROXY_NETWORK.
# PROXY_NETWORK should hold only nginx-proxy and this app: any container on it can
# reach the app directly. Create it with `docker network create aidash` and
# `docker network connect aidash nginx-proxy` (and add it to the proxy's compose).
# Best on a subdomain of its own (ai.example.com, BASE_PATH=/ai still works): other
# apps on the same origin could otherwise use your login.
DOMAIN=example.com
BASE_PATH=/ai
PROXY_NETWORK=aidash
# Container name of the reverse proxy: only its X-Real-IP header is believed.
# TRUSTED_PROXY=nginx-proxy

# The user who runs tmux and Claude on the host: `id -u`:`id -g`.
# The dashboard sees that user's tmux server only.
RUN_AS=1000:1000
# Socket dir of that user's tmux server: /tmp/tmux-<uid> (check: echo $TMUX).
TMUX_SOCKET_DIR=/tmp/tmux-1000
# TMUX_SOCKET_NAME=default   # only if you use tmux -L <name>
# Folder that holds your projects (one subfolder per project).
PROJECTS_DIR=/home/me/projects
# That user's ~/.claude (personal skills, usage-limit bars).
CLAUDE_DIR=/home/me/.claude

# Screenshots that sessions share with you and that you upload for them (default:
# CLAUDE_DIR/screenshots). The dashboard installs the dashboard-screenshots skill into
# CLAUDE_DIR/skills on start, so every Claude session on this host can use it.
# SHOTS_DIR=/home/me/.claude/screenshots
# SHOTS_KEEP_DAYS=14
# SHOTS_MAX_MB=500

# Base image whose tmux matches the host's `tmux -V`.
# ubuntu:22.04 = 3.2a, debian:12 = 3.3a, ubuntu:24.04 = 3.4
BASE_IMAGE=ubuntu:22.04

# Cron jobs view: the crontab of CRON_USER in the host cron spool (needs RUN_AS=0:0,
# the spool is closed to other users). LOG_GROUP may read /var/log/syslog (last runs).
CRON_USER=root
# CRON_SPOOL=/var/spool/cron/crontabs
# LOG_GROUP=4
